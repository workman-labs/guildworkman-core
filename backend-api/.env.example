# Copy to .env locally and fill in real values. Never commit a populated .env.
# Spring Boot doesn't read .env files itself -- use this with `docker run
# --env-file .env`, `export $(grep -v '^#' .env | xargs)`, or your IDE's
# run-configuration env-var support.

DATABASE_URL=jdbc:postgresql://localhost:5432/service
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DDL_AUTO=update

# Brevo (Sendinblue) transactional email
MAIL_API_KEY=
MAIL_API_URL=https://api.brevo.com/v3/smtp/email

# Cloudinary media uploads
CLOUDINARY_API_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack payments
PAYSTACK_SECRET_KEY=
PAYSTACK_VERIFY_URL=https://api.paystack.co/transaction/verify
PAYSTACK_INITIATE_URL=https://api.paystack.co/transaction/initialize

# Stellar key custody & transaction signing (backend-api/docs/STELLAR_SIGNING.md).
# `local` reads seeds from the STELLAR_LOCAL_KEYS_* variables below and is for
# development and CI only. Real environments run `kms`, where the secret key
# never leaves the gateway and none of the seed variables are set at all.
STELLAR_SIGNING_PROVIDER=local
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The rollback lever: `false` stops signing, broadcasting and polling without a
# deploy. Submissions are still accepted and queue as PENDING; nothing is lost,
# and turning it back on resumes exactly where it stopped. See the operator
# runbook in backend-api/docs/STELLAR_SIGNING.md.
STELLAR_SIGNING_ENABLED=true

# One entry per channel account, keyed by the reference used to register it:
# STELLAR_LOCAL_KEYS_<KEYREF>=S...  ->  stellar.signing.local.keys.<keyref>
# These are secret seeds. Keep them in .env (git-ignored), never in a commit,
# and use throwaway testnet accounts.
STELLAR_LOCAL_KEYS_CHANNEL1=
STELLAR_LOCAL_KEYS_CHANNEL2=

# KMS/HSM gateway, used when STELLAR_SIGNING_PROVIDER=kms. The URL must be
# https (loopback excepted) and the API key must be set — both are checked at
# startup, so a misconfigured gateway fails the boot rather than the first
# signature.
STELLAR_KMS_URL=
STELLAR_KMS_API_KEY=

H2_CONSOLE_ENABLED=false
